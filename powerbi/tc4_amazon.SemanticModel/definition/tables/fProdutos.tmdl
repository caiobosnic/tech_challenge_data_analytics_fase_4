	column faixa_nota = SWITCH(TRUE(), ISBLANK(fProdutos[rating]), "sem nota", fProdutos[rating] < 3.0, "abaixo de 3,0", fProdutos[rating] < 3.5, "3,0 a 3,4", fProdutos[rating] < 4.0, "3,5 a 3,9", fProdutos[rating] < 4.3, "4,0 a 4,2", fProdutos[rating] < 4.5, "4,3 a 4,4", "4,5 ou mais")
		dataType: string
		lineageTag: 26f327b0-b90b-5445-b374-be909ed22891
		summarizeBy: none
		sortByColumn: faixa_nota_ordem

		annotation SummarizationSetBy = Automatic

	column faixa_nota_ordem = SWITCH(TRUE(), ISBLANK(fProdutos[rating]), 0, fProdutos[rating] < 3.0, 1, fProdutos[rating] < 3.5, 2, fProdutos[rating] < 4.0, 3, fProdutos[rating] < 4.3, 4, fProdutos[rating] < 4.5, 5, 6)
		dataType: int64
		isHidden
		lineageTag: 206aa059-020c-50e3-a004-b7f8a234f0b9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column faixa_preco = SWITCH(TRUE(), fProdutos[discounted_price_rupia] < 200, "ate 200", fProdutos[discounted_price_rupia] < 500, "200 a 500", fProdutos[discounted_price_rupia] < 1000, "500 a 1.000", fProdutos[discounted_price_rupia] < 2000, "1.000 a 2.000", fProdutos[discounted_price_rupia] < 5000, "2.000 a 5.000", "acima de 5.000")
		dataType: string
		lineageTag: c79c86e5-1f82-58d7-ae37-1238321c4bb3
		summarizeBy: none
		sortByColumn: faixa_preco_ordem

		annotation SummarizationSetBy = Automatic

	column faixa_desconto = SWITCH(TRUE(), fProdutos[discount_percentage] < 0.2, "ate 20%", fProdutos[discount_percentage] < 0.4, "20 a 40%", fProdutos[discount_percentage] < 0.6, "40 a 60%", fProdutos[discount_percentage] < 0.8, "60 a 80%", "80% ou mais")
		dataType: string
		lineageTag: fd7b0856-9eeb-51d0-a521-5039926fe0cf
		summarizeBy: none
		sortByColumn: faixa_desconto_ordem

		annotation SummarizationSetBy = Automatic

	column faixa_desconto_ordem = SWITCH(TRUE(), fProdutos[discount_percentage] < 0.2, 1, fProdutos[discount_percentage] < 0.4, 2, fProdutos[discount_percentage] < 0.6, 3, fProdutos[discount_percentage] < 0.8, 4, 5)
		dataType: int64
		isHidden
		lineageTag: be800740-7e16-5faa-8648-defb76b2842c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column faixa_engajamento = SWITCH(TRUE(), fProdutos[rating_count] <= 1106, "ate 1.100", fProdutos[rating_count] <= 4740, "1.100 a 4.700", fProdutos[rating_count] <= 16020, "4.700 a 16.000", "acima de 16.000")
		dataType: string
		lineageTag: 5ab0a63f-0fa0-5cc8-8973-793b4941612e
		summarizeBy: none
		sortByColumn: faixa_engajamento_ordem

		annotation SummarizationSetBy = Automatic

	column faixa_engajamento_ordem = SWITCH(TRUE(), fProdutos[rating_count] <= 1106, 1, fProdutos[rating_count] <= 4740, 2, fProdutos[rating_count] <= 16020, 3, 4)
		dataType: int64
		isHidden
		lineageTag: d97fd3e6-fb16-5c76-bf9d-54f26ab846bb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column bolso = SWITCH( TRUE(), fProdutos[rating_count] >= 4740 && fProdutos[rating] <= 3.9, "muito avaliado, nota baixa", fProdutos[rating] >= 4.3 && fProdutos[rating_count] < 1000, "nota alta, pouco visto", "fora dos bolsos" )
		dataType: string
		lineageTag: b8326022-e74d-59e3-9f97-cacac15ec419
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column top_avaliacoes = IF( RANKX( ALL(fProdutos), fProdutos[rating_count], , DESC ) <= 10, "sim", "nao" )
		dataType: string
		lineageTag: f8007d8b-a8a7-55ab-b29f-59c16a0784d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column faixa_preco_ordem = SWITCH(TRUE(), fProdutos[discounted_price_rupia] < 200, 1, fProdutos[discounted_price_rupia] < 500, 2, fProdutos[discounted_price_rupia] < 1000, 3, fProdutos[discounted_price_rupia] < 2000, 4, fProdutos[discounted_price_rupia] < 5000, 5, 6)
		dataType: int64
		isHidden
		lineageTag: e4ff8c52-e26b-5238-be42-54ed5a3bd786
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fProdutos = m
		mode: import
		source =
				let
				    Origem = Csv.Document(File.Contents("C:\\Users\\bosni\\OneDrive\\Documentos\\Fiap\\PosTech - Data Analytics\\techchallenge\\tech_challenge_4\\results\\fProdutos.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecalho = Table.PromoteHeaders(Origem, [PromoteAllScalars=true]),
				    Tipado = Table.TransformColumnTypes(Cabecalho, {{"product_id", type text}, {"product_name", type text}, {"discounted_price_rupia", type number}, {"actual_price_rupia", type number}, {"discount_percentage", type number}, {"rating", type number}, {"rating_count", Int64.Type}, {"img_link", type text}, {"product_link", type text}, {"sk_categoria", Int64.Type}, {"desconto_absoluto_rupia", type number}, {"receita_potencial_rupia", type number}, {"percepcao", type text}}, "en-US")
				in
				    Tipado

	annotation PBI_ResultType = Table
