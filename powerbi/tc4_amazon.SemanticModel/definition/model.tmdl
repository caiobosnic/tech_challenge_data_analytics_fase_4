model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dCategoria","fProdutos","fAvaliacoes","dTermosAvaliacao","dMoeda","_Medidas","dTermoComparado","dRecomendacao","dFonte"]


ref cultureInfo pt-BR

ref table dCategoria
ref table fProdutos
ref table fAvaliacoes
ref table dTermosAvaliacao
ref table dTermoComparado
ref table dRecomendacao
ref table dFonte
ref table dMoeda
ref table _Medidas
